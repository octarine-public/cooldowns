{
	"compileOnSave": true,
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noUnusedLocals": true,
		"strict": true,
		"alwaysStrict": true,
		"experimentalDecorators": true,
		"jsx": "react",
		"jsxFactory": "React.createElement",
		"jsxFragmentFactory": "React.Fragment",
		"forceConsistentCasingInFileNames": true,
		"lib": [
			"ESNext"
		]
	},
	"include": [
		"./**/*.ts",
		"./**/*.tsx"
	],
	"exclude": [
		"tools/**/*",
		"node_modules/**/*",
		"scripts_files/**/*"
	]
}
